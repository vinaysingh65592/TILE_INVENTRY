// Prisma schema for Tile Warehouse Inventory System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Position values: "STARTING" | "MIDDLE" | "LAST"

model User {
  id           String              @id @default(uuid())
  name         String
  username     String              @unique
  passwordHash String
  role         String              // "ADMIN" | "SUPERVISOR" | "SALESMAN"
  isActive     Boolean             @default(true)
  status             String              @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED"
  mustChangePassword Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  auditLogs    InventoryAuditLog[]

  @@index([username])
  @@index([role])
  @@index([status])
}

model TileInventory {
  id                String              @id @default(uuid())
  tileDesignName    String
  section           String
  position          String              // STARTING, MIDDLE, LAST
  quantity          Int                 @default(0)
  note              String?
  createdById       String?
  createdByName     String?
  lastUpdatedById   String?
  lastUpdatedByName String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  auditLogs         InventoryAuditLog[]

  @@index([tileDesignName])
  @@index([section])
  @@index([position])
  @@index([createdAt])
}

model SectionConfig {
  id        String   @id @default(uuid())
  code      String   @unique
  prefix    String
  createdAt DateTime @default(now())

  @@index([prefix])
  @@index([code])
}

model InventoryAuditLog {
  id               String         @id @default(uuid())
  tileId           String
  tile             TileInventory  @relation(fields: [tileId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?          @relation(fields: [userId], references: [id])
  userNameSnapshot String
  userRole         String
  actionType       String         // TILE_CREATED | QUANTITY_UPDATE | SALE | LOADING | TILE_EDITED | TILE_DELETED
  previousQuantity Int?
  newQuantity      Int?
  quantityChanged  Int?
  quantitySold     Int?
  quantityLoaded   Int?
  vehicleNumber    String?
  referenceNumber  String?
  note             String?
  createdAt        DateTime       @default(now())

  @@index([tileId])
  @@index([actionType])
  @@index([createdAt])
  @@index([userId])
}

model DisplayTile {
  id              String   @id @default(uuid())
  tileInventoryId String?
  company         String   // Company / Brand (e.g. Kajaria, Somany, Simpolo)
  tileDesign      String   // Design / Name
  category        String   // Category (e.g. Floor, Wall, GVT, PGVT, Ceramic)
  size            String   // Size (e.g. 600x1200 mm, 2x4 ft)
  imageUrl        String?  // Image URL / photo
  mrp             Float    // Maximum Retail Price
  finalMrp        Float    // Final customer offer price
  note            String?
  addedById       String?
  addedByName     String?
  addedByRole     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([company])
  @@index([category])
  @@index([createdAt])
}

model Material {
  id           String   @id @default(uuid())
  company      String   // Material company (e.g. Roff, Pidilite, MYK Laticrete)
  materialName String   // Name (e.g. Tile Adhesive T01, Epoxy Grout)
  weight       String   // Weight / pack size (e.g. 20 kg, 5 kg)
  category     String?  // Category (Adhesive, Grout, Spacer, Chemical)
  mrp          Float    // Maximum Retail Price
  finalMrp     Float    // Final selling price
  note         String?
  addedById    String?
  addedByName  String?
  addedByRole  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([company])
  @@index([category])
  @@index([createdAt])
}
